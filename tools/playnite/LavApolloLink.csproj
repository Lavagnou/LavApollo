<Project Sdk="Microsoft.NET.Sdk">
  <!-- LavApollo Link: Playnite extension that exports the library and the running game to LavApollo.
       See docs/superpowers/specs/2026-11-23-playnite-integration-design.md.
       Build: dotnet build -c Release (the reference assemblies come from NuGet, no targeting pack needed). -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>LavApolloLink</AssemblyName>
    <RootNamespace>LavApolloLink</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Version>1.1.0</Version>
    <Product>LavApollo Link</Product>
    <Description>Exports the Playnite library and the running game to LavApollo</Description>
    <Copyright>Lavagnou</Copyright>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Playnite loads its own Playnite.SDK.dll: compile against it, never ship it. -->
    <PackageReference Include="PlayniteSDK" Version="6.15.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
